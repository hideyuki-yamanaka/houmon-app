# Supabase 接続情報（Supabase ダッシュボード > Settings > API から取得）
# ローカルでは .env.local にコピーして値を入れる
# 本番（Vercel）では Vercel ダッシュボード > Settings > Environment Variables に登録
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Supabase サービスロールキー (RLS を貫通する強権限キー)
# 用途:
#   - GitHub Actions の自動 CSV バックアップ (scripts/backup-to-csv.mjs)
#   - サーバーサイドで anon では読めない行を読みたい時
# 取得: Supabase ダッシュボード > Settings > API > service_role key
# ⚠️ 絶対に NEXT_PUBLIC_ を付けない (ブラウザに漏れる)
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# （任意）basePath — サブパスで公開する場合のみ設定
# BASE_PATH=/houmon-app

# （任意・Phase 2）プッシュ通知 VAPID 鍵セット
# 生成方法: npx web-push generate-vapid-keys
# 公開鍵はクライアント側で購読登録に必要 → NEXT_PUBLIC_ プレフィックス必須
# 秘密鍵はサーバー側専用 (送信時の署名用)、subject は連絡先メール
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEXXXXXX...
# VAPID_PRIVATE_KEY=XXXXXXXX
# VAPID_SUBJECT=mailto:you@example.com

# （任意）週次通知 cron 認証用シークレット
# GitHub Actions などから /api/notify/weekly を叩く時に
# X-Cron-Secret ヘッダで一致確認するための任意の長文字列
# NOTIFY_CRON_SECRET=your-long-random-secret

# （任意）Claude API キー (訪問メモの校正機能 /api/proofread/visits 用)
# 未設定だと校正機能が 500 を返す
# 取得: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# （Phase 1.5）共有・招待メール送信 (Resend)
# https://resend.com で API キー発行 → Vercel に登録
# RESEND_API_KEY=re_XXXXXXXX
# 任意: 送信元アドレス (Resend のドメイン認証済アドレスを使う場合)
# 未指定なら 'onboarding@resend.dev' (デフォ送信元)
# INVITE_FROM_EMAIL=noreply@example.com
# 任意: 招待リンクのベース URL (Vercel 本番 URL を明示したい時)
# 未指定なら リクエスト元の origin を使う
# INVITE_BASE_URL=https://houmon-app-lilac.vercel.app
